{
  "name": "tokenize-tokyo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "forge test --root contracts",
    "test:e2e": "playwright test",
    "multibaas:verify": "tsx scripts/verify-multibaas.ts",
    "ens:inspect": "tsx scripts/inspect-ens.ts",
    "ens:preflight": "tsx scripts/ens-preflight.ts",
    "ens:setup:sepolia": "tsx scripts/setup-ens-sepolia.ts",
    "ens:link:multibaas": "tsx scripts/link-ens-multibaas.ts",
    "ens:verify:delegation": "tsx scripts/verify-ens-delegation.ts",
    "multibaas:link": "tsx scripts/link-multibaas.ts",
    "demo:seed": "tsx scripts/seed.ts",
    "demo:seed:testnet": "tsx scripts/seed-testnet.ts",
    "demo:verify:testnet": "tsx scripts/verify-testnet-demo.ts",
    "operator": "tsx scripts/operator.ts",
    "deploy:local": "cd contracts && DEPLOYER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266 forge script script/Deploy.s.sol:Deploy --rpc-url http://127.0.0.1:8545 --broadcast --unlocked --sender 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266",
    "anvil": "anvil --host 127.0.0.1 --port 8545 --silent",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@curvegrid/multibaas-sdk": "^1.1.1",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
