# demo = local browser simulation, multibaas = real SDK + browser wallet. No silent fallback.
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_MULTIBAAS_URL=
# DApp User group ONLY. Never paste an admin key here.
NEXT_PUBLIC_MULTIBAAS_DAPP_KEY=
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=
# Optional: Privy email/Google login plus MetaMask.
# Public IDs only. Login remains disabled until a real Privy app is configured.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: enables the additional WalletConnect choices. Not needed for MetaMask.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_RIGHTS_ADDRESS=
NEXT_PUBLIC_MARKET_ADDRESS=
NEXT_PUBLIC_REVENUE_ADDRESS=
NEXT_PUBLIC_BASKET_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_ADDRESS=
# Optional custody-backed finance extension, deployed against these same rights/revenue contracts.
NEXT_PUBLIC_FRACTION_ADDRESS=
NEXT_PUBLIC_RENTAL_ADDRESS=
# Server/deployment only. Never NEXT_PUBLIC_.
MULTIBAAS_URL=
MULTIBAAS_API_KEY=
MULTIBAAS_WEBHOOK_SECRET=
# Server-only, dedicated Internal-group key for the Curvegrid Testnet faucet.
# Do not use an admin key or a NEXT_PUBLIC_ variable for this.
MULTIBAAS_FAUCET_KEY=
# Fixed production website origin for signed test-gas requests.
APP_ORIGIN=https://tokenize-tokyo.vercel.app
# Persistent directory, shared by webhook and /api/activity handlers. Single Node server.
WEBHOOK_DATA_DIR=.data
NETWORK_RPC_URL=
# Prefer forge --account for deployment; PRIVATE_KEY only in your uncommitted local shell.
PRIVATE_KEY=
DEPLOYER_ADDRESS=
ADMIN_ADDRESS=
# Optional Azure-configured Cloud Wallet operator
MULTIBAAS_OPERATOR_ADDRESS=
# Optional Stripe TEST checkout. Disabled until Cloud Wallet, executor and database are ready.
# Use only sk_test_, never sk_live_. These settings are all server-only.
STRIPE_CARD_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CARD_CHECKOUT_EXECUTOR_ADDRESS=
# Durable PostgreSQL; apply db/card-checkout.sql before enabling checkout (also on Vercel).
CARD_CHECKOUT_DATABASE_URL=
# Azure provider configuration for scripts/setup-cloud-wallet.ts --apply only.
# Keep these server-only. Create the Azure account/vault first; see docs/WALLET_SETUP.md.
CLOUD_WALLET_LABEL=tokenize-tokyo-operator
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_KEY_VAULT=
AZURE_KEY_NAME=tokenize-operator
# Chain ID / deployed contract manifest used by deployment scripts
DEPLOYMENT_FILE=deployments/31337.json
# Optional read-only ENSv2 prototype. Sepolia only; no signing key required.
ENSV2_RPC_URL=
# Trusted registry containing the team's controlled parent label, verified against official deployment.
ENSV2_PARENT_REGISTRY=
# Root-to-leaf labels, for example actual-parent/chiyoda/building-1024/rooftop
ENSV2_NAMESPACE_PATH=
ENSV2_OPERATOR_ADDRESS=

# Separate Sepolia deployment setup. Copy these to .env.sepolia (gitignored).
# scripts/setup-ens-sepolia.ts never loads .env.local implicitly.
ENSV2_DEPLOYER_PRIVATE_KEY=
ENSV2_PARENT_LABEL=
ENSV2_JOURNAL_DIR=.data/ens-sepolia
ENSV2_DEPLOYMENT_FILE=.data/ens-sepolia/deployment.json
# Enable only after public deployment AND Sepolia MultiBaas linking.
NEXT_PUBLIC_ENSV2_AUTHORITY_ADDRESS=
NEXT_PUBLIC_ENSV2_PARENT=
NEXT_PUBLIC_ENSV2_ASSET_ID=
NEXT_PUBLIC_ENSV2_SCOPE=0
