# demo = local browser simulation, multibaas = real SDK + browser wallet. No silent fallback.
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_MULTIBAAS_URL=
# DApp User group ONLY. Never paste an admin key here.
NEXT_PUBLIC_MULTIBAAS_DAPP_KEY=
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_RIGHTS_ADDRESS=
NEXT_PUBLIC_MARKET_ADDRESS=
NEXT_PUBLIC_REVENUE_ADDRESS=
NEXT_PUBLIC_BASKET_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_ADDRESS=
# Server/deployment only. Never NEXT_PUBLIC_.
MULTIBAAS_URL=
MULTIBAAS_API_KEY=
MULTIBAAS_WEBHOOK_SECRET=
# Persistent directory, shared by webhook and /api/activity handlers. Single Node server.
WEBHOOK_DATA_DIR=.data
NETWORK_RPC_URL=
# Prefer forge --account for deployment; PRIVATE_KEY only in your uncommitted local shell.
PRIVATE_KEY=
DEPLOYER_ADDRESS=
ADMIN_ADDRESS=
# Optional Azure-configured Cloud Wallet operator
MULTIBAAS_OPERATOR_ADDRESS=
# Chain ID / deployed contract manifest used by deployment scripts
DEPLOYMENT_FILE=deployments/31337.json
